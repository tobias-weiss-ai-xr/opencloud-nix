#
# Copy to .env and fill in real secrets (the file is gitignored):
#   cp .env.example .env
# or simply:  make compose-setup   (creates .env with random secrets)

# Image to run (must be `docker load`-ed first — `make image-load`)
OPENCLOUD_IMAGE=opencloud:9.1.0

# Service URL + exposed port
OPENCLOUD_URL=http://localhost:9200
OPENCLOUD_PORT=9200

# Demo-friendly runtime settings (disable in production)
OC_INSECURE=true
OC_LOG_LEVEL=info
IDM_CREATE_DEMO_USERS=true
PROXY_ENABLE_BASIC_AUTH=true

# Identity
OPENCLOUD_ADMIN_USER_ID=admin
OPENCLOUD_SYSTEM_USER_ID=admin

# Secrets — generate 64 hex chars each, e.g. `openssl rand -hex 32`
OPENCLOUD_JWT_SECRET=
OPENCLOUD_TRANSFER_SECRET=
OPENCLOUD_MACHINE_AUTH_API_KEY=
OPENCLOUD_SYSTEM_USER_API_KEY=
OPENCLOUD_URL_SIGNING_SECRET=
